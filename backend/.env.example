NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
API_PREFIX=/api/v1
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
LOG_LEVEL=debug

# Docker Compose PostgreSQL (preferred local setup — see ../compose.yaml)
# Host port 5433 avoids conflicts with another local Postgres on 5432.
DATABASE_URL=postgresql://capstone:capstone_local_db@localhost:5433/partsark_capstone?schema=public
DATABASE_URL_UNPOOLED=postgresql://capstone:capstone_local_db@localhost:5433/partsark_capstone?schema=public
# Integration tests must use a separate database.
TEST_DATABASE_URL=postgresql://capstone:capstone_local_db@localhost:5433/partsark_capstone_test?schema=public

# Generate independent secrets, for example: openssl rand -hex 48
ACCESS_TOKEN_SECRET=replace_with_an_independent_random_secret_at_least_32_chars
TOKEN_HASH_SECRET=replace_with_another_independent_random_secret_at_least_32_chars
JWT_ISSUER=partsarc-api
JWT_AUDIENCE=partsarc-frontends
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
SUPPLIER_INVITATION_TTL_HOURS=72
SUPPLIER_INVITATION_URL_BASE=http://localhost:3001/accept-invitation

REFRESH_COOKIE_NAME=partsarc_refresh
CSRF_COOKIE_NAME=partsarc_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
RECOVERY_OUTBOX_DIR=.local/recovery-outbox
REQUEST_ATTACHMENT_DIR=.local/request-attachments
NOTIFICATION_OUTBOX_DIR=.local/notification-outbox
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
# Local Redis for the worker and catalogue cache.
REDIS_URL=redis://:capstone_local_redis@127.0.0.1:6380
REDIS_KEY_PREFIX=partsarc:capstone
CATALOGUE_CACHE_TTL_SECONDS=120
CATALOGUE_LOCAL_CACHE_MAX_ENTRIES=200
CATALOGUE_GENERATION_CACHE_SECONDS=5
JOB_BATCH_SIZE=100
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_TTL_SECONDS=90
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_STORE=memory

# Filesystem storage and file outboxes for local development.
ATTACHMENT_STORAGE_PROVIDER=local
EMAIL_DELIVERY_PROVIDER=local
SUPPLIER_IMAGE_MAX_COUNT=1000
SUPPLIER_IMAGE_MAX_BYTES=1073741824
LISTING_IMAGE_ORPHAN_GRACE_HOURS=24
LISTING_IMAGE_RECONCILE_BATCH_SIZE=100
