// PartsArc Task 2 — Database design
// Application services generate public identifiers (requestNumber, quotationNumber, etc.).
// Do not generate those sequences inside this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  SUPPLIER_OWNER
  SUPPLIER_STAFF
  ADMIN
  SUPER_ADMIN
  GARAGE_USER
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum InvitationType {
  SUPPLIER_OWNER
  SUPPLIER_STAFF
  ADMIN
}

enum SupplierBusinessStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductCondition {
  NEW
  RECONDITIONED
  USED
}

enum InventoryAvailability {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  HIDDEN
}

enum InventoryImportStatus {
  PREVIEWED
  CONFIRMED
  EXPIRED
}

enum SupplierListingClassification {
  NEW_GENUINE
  NEW_AFTERMARKET
  USED
}

enum ListingPublicationStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum ListingModerationStatus {
  NOT_REVIEWED
  APPROVED
  FLAGGED
  REJECTED
}

enum SourcingRequestType {
  CUSTOM_SOURCING
  FIXED_PRICE_PURCHASE
  USED_PART_RFQ
}

enum CreditRequirementStatus {
  NOT_APPLICABLE
  ELIGIBLE
  AWAITING_CREDITS
  RESERVED
}

enum SupplierWalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletTopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletEntryType {
  TOP_UP
  CREDIT_RESERVATION
  COMMISSION_SETTLEMENT
  RESERVATION_RELEASE
  ADJUSTMENT
  REVERSAL
}

enum CommissionReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  REVERSED
}

enum RequestUrgency {
  STANDARD
  URGENT
}

enum SourcingRequestStatus {
  DRAFT
  SUBMITTED
  MATCHING
  QUOTING
  AWAITING_CUSTOMER
  ACCEPTED
  ORDERED
  CANCELLED
  EXPIRED
  CLOSED
}

enum RequestItemStatus {
  OPEN
  QUOTED
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum SupplierAssignmentStatus {
  ASSIGNED
  VIEWED
  SKIPPED
  QUOTED
  EXPIRED
  WITHDRAWN
}

enum SupplierAssignmentEventType {
  ASSIGNED
  VIEWED
  SKIPPED
  EXPIRED
  WITHDRAWN
  DEADLINE_CHANGED
  CLARIFICATION_ASKED
  CLARIFICATION_REPLIED
  QUOTED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  ADMIN_REVIEW
  CLARIFICATION
  SENT_TO_CUSTOMER
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
  WITHDRAWN
}

enum AdminReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ClarificationInitiator {
  SUPPLIER
  ADMIN
}

enum SourcingOptionStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
  REJECTED
  ACCEPTED
  INVALIDATED
  EXPIRED
}

enum OrderStatus {
  PENDING_SUPPLIER_CONFIRMATION
  CONFIRMED
  SUPPLIER_PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
  RETURNED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  RESTORED
}

enum InventoryReservationEventType {
  RESERVED
  RELEASED
  CONSUMED
  RESTORED
}

enum OrderConversionStatus {
  ORDER_CREATED
  EXCEPTION
}

enum OrderCancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTED
}

enum UrgentEligibilityStatus {
  NOT_APPLICABLE
  PENDING
  ELIGIBLE
  UNAVAILABLE
}

enum DeliveryStatus {
  SCHEDULED
  COURIER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  SCHEDULED
  PAID
  ON_HOLD
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
}

enum TransactionType {
  CUSTOMER_PAYMENT
  SUPPLIER_PAYABLE
  SUPPLIER_PAYOUT
  SUPPLIER_RECOVERY
  PLATFORM_MARGIN
  DELIVERY_CHARGE
  PRIORITY_CHARGE
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum SupplierPayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  RECOVERY_DUE
}

enum OperationalCaseType {
  ORDER_EXCEPTION
  DELIVERY_EXCEPTION
  CANCELLATION
  RETURN
  REFUND
  DISPUTE
  OTHER
}

enum OperationalCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum ConversationType {
  REQUEST
  QUOTATION
  ORDER
  SUPPORT
  GENERAL
}

enum ParticipantType {
  CUSTOMER
  SUPPLIER
  ADMIN
  SYSTEM
}

enum MessageSenderType {
  CUSTOMER
  SUPPLIER
  ADMIN
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
  OTHER
}

enum SupplierSubscriptionStatus {
  PENDING
  SCHEDULED
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum SubscriptionInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum SubscriptionPaymentKind {
  PAYMENT
  REVERSAL
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String        @unique
  fullName           String?
  phone              String?
  passwordHash       String
  role               UserRole
  accountStatus      AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?
  disabledAt         DateTime?
  mustChangePassword Boolean       @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customerProfile              CustomerProfile?
  garageMembership             GarageMembership?
  supplierMemberships          SupplierUser[]
  invitationsSent              AccountInvitation[]           @relation("InvitationInviter")
  invitationsAccepted          AccountInvitation[]           @relation("InvitationAcceptor")
  refreshSessions              RefreshSession[]
  passwordResetTokens          PasswordResetToken[]
  verificationTokens           VerificationToken[]
  ownedBusinesses              SupplierBusiness[]            @relation("BusinessOwnerUser")
  conversationParts            ConversationParticipant[]
  messagesSent                 Message[]
  notifications                Notification[]
  auditLogs                    AuditLog[]
  statusChanges                RequestStatusHistory[]        @relation("RequestStatusActor")
  quotationStatusChanges       QuotationStatusHistory[]      @relation("QuotationStatusActor")
  fulfillmentChanges           FulfillmentStatusHistory[]    @relation("FulfillmentStatusActor")
  deliveryStatusChanges        DeliveryStatusHistory[]       @relation("DeliveryStatusActor")
  inventoryAdjustments         InventoryStockAdjustment[]    @relation("InventoryAdjustmentActor")
  inventoryImportPreviews      InventoryCsvPreview[]         @relation("InventoryImportCreator")
  supplierAssignmentEvents     SupplierAssignmentHistory[]   @relation("SupplierAssignmentHistoryActor")
  clarificationsAsked          SupplierClarification[]       @relation("SupplierClarificationAsker")
  clarificationsReplied        SupplierClarification[]       @relation("SupplierClarificationReplier")
  optionClarificationsAsked    CustomerOptionClarification[] @relation("CustomerOptionClarificationAsker")
  optionClarificationsReplied  CustomerOptionClarification[] @relation("CustomerOptionClarificationReplier")
  optionHistoryChanges         SourcingOptionHistory[]       @relation("SourcingOptionHistoryActor")
  reservationEvents            InventoryReservationEvent[]   @relation("InventoryReservationEventActor")
  cancellationRequests         OrderCancellationRequest[]    @relation("OrderCancellationRequester")
  cancellationDecisions        OrderCancellationRequest[]    @relation("OrderCancellationDecisionActor")
  orderFailuresReported        OrderFailure[]                @relation("OrderFailureReporter")
  orderReturnsRequested        OrderReturn[]                 @relation("OrderReturnRequester")
  orderReturnsDecided          OrderReturn[]                 @relation("OrderReturnDecisionActor")
  orderReturnsReceived         OrderReturn[]                 @relation("OrderReturnReceiver")
  urgentFulfillmentChanges     UrgentFulfillmentHistory[]    @relation("UrgentFulfillmentActor")
  notificationDeliveries       NotificationDelivery[]
  financialEntriesRecorded     Transaction[]                 @relation("TransactionRecorder")
  invoicesIssued               Invoice[]                     @relation("InvoiceIssuer")
  invoicesVoided               Invoice[]                     @relation("InvoiceVoidActor")
  settlementsRecorded          SupplierSettlement[]          @relation("SettlementRecorder")
  refundsApproved              Refund[]                      @relation("RefundApprover")
  refundsProcessed             Refund[]                      @relation("RefundProcessor")
  operationalCasesAssigned     OperationalCase[]             @relation("OperationalCaseAssignee")
  operationalCaseHistory       OperationalCaseHistory[]      @relation("OperationalCaseHistoryActor")
  businessConfigurations       PlatformBusinessConfig[]      @relation("BusinessConfigUpdater")
  subscriptionsCreated         SupplierSubscription[]        @relation("SubscriptionCreator")
  subscriptionEvents           SupplierSubscriptionEvent[]   @relation("SubscriptionEventActor")
  subscriptionInvoicesIssued   SubscriptionInvoice[]         @relation("SubscriptionInvoiceIssuer")
  subscriptionInvoicesVoided   SubscriptionInvoice[]         @relation("SubscriptionInvoiceVoidActor")
  subscriptionPaymentsRecorded SubscriptionPayment[]         @relation("SubscriptionPaymentRecorder")
  categoryRequestsReviewed     SupplierCategoryRequest[]     @relation("CategoryRequestReviewer")
  categoryRequestsCreated      SupplierCategoryRequest[]     @relation("CategoryRequestCreator")
  listingsModerated            SupplierInventory[]           @relation("ListingModerator")
  commissionPoliciesCreated    CommissionPolicy[]            @relation("CommissionPolicyCreator")
  walletTopUpsCreated          WalletTopUp[]                 @relation("WalletTopUpCreator")
  walletTopUpsReviewed         WalletTopUp[]                 @relation("WalletTopUpReviewer")
  walletEntriesRecorded        WalletLedgerEntry[]           @relation("WalletEntryActor")

  @@index([role, accountStatus])
  @@index([createdAt])
  @@map("users")
}

model CustomerProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  fullName      String
  preferredName String?
  companyName   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                 User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  garageJobs           GarageJob[]
  addresses            CustomerAddress[]
  vehicles             Vehicle[]
  sourcingRequests     SourcingRequest[]
  orders               Order[]
  invoices             Invoice[]
  transactions         Transaction[]
  refunds              Refund[]
  optionClarifications CustomerOptionClarification[]
  optionAcceptances    OptionAcceptance[]
  cancellationRequests OrderCancellationRequest[]
  returns              OrderReturn[]
  conversations        Conversation[]

  @@index([fullName])
  @@map("customer_profiles")
}

model SupplierBusiness {
  id                      String                 @id @default(uuid()) @db.Uuid
  /// Public business code for operations; generated by application services later.
  businessCode            String?                @unique
  legalName               String
  displayName             String
  tradeLicense            String?
  vatNumber               String?
  email                   String?
  phone                   String?
  status                  SupplierBusinessStatus @default(DRAFT)
  verifiedAt              DateTime?
  suspendedAt             DateTime?
  suspendedReason         String?
  closedAt                DateTime?
  ownerUserId             String?                @db.Uuid
  serviceAreas            String[]               @default([])
  supportedCategories     String[]               @default([])
  subscriptionGraceEndsAt DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  ownerUser               User?                       @relation("BusinessOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members                 SupplierUser[]
  locations               SupplierLocation[]
  inventory               SupplierInventory[]
  assignments             SupplierRequestAssignment[]
  quotations              Quotation[]
  orders                  Order[]
  settlements             SupplierSettlement[]
  invitations             AccountInvitation[]
  stockAdjustments        InventoryStockAdjustment[]
  inventoryImportPreviews InventoryCsvPreview[]
  inventoryReservations   InventoryReservation[]
  conversations           Conversation[]
  financialEntries        Transaction[]
  payables                SupplierPayable[]
  operationalCases        OperationalCase[]
  subscriptions           SupplierSubscription[]
  subscriptionInvoices    SubscriptionInvoice[]
  categoryRequests        SupplierCategoryRequest[]
  targetedRequests        SourcingRequest[]           @relation("TargetSupplierRequests")
  wallet                  SupplierWallet?
  walletTopUps            WalletTopUp[]
  commissionReservations  CommissionReservation[]
  walletEntries           WalletLedgerEntry[]

  @@index([status])
  @@index([displayName])
  @@index([ownerUserId])
  @@map("supplier_businesses")
}

model SupplierUser {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  userId     String    @db.Uuid
  title      String?
  isPrimary  Boolean   @default(false)
  isActive   Boolean   @default(true)
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business SupplierBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, isActive])
  @@map("supplier_users")
}

model SupplierLocation {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  label       String
  addressLine String
  city        String
  area        String?
  postalCode  String?
  phone       String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   SupplierBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([businessId, isActive])
  @@map("supplier_locations")
}

model AccountInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  email            String
  invitationType   InvitationType
  status           InvitationStatus @default(PENDING)
  /// Hashed invitation token only — never store plaintext tokens.
  tokenHash        String           @unique
  businessId       String?          @db.Uuid
  invitedByUserId  String           @db.Uuid
  acceptedByUserId String?          @db.Uuid
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  business   SupplierBusiness? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  invitedBy  User              @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User?             @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([businessId, status])
  @@index([expiresAt])
  @@map("account_invitations")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  /// Stable identifier shared by every rotated token for one device session.
  familyId            String    @db.Uuid
  /// Hashed refresh token only.
  tokenHash           String    @unique
  /// Hash of the double-submit CSRF token paired with this refresh token.
  csrfTokenHash       String
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// Hashed reset token only.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// Hashed verification token only.
  tokenHash String    @unique
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Customer information
// ---------------------------------------------------------------------------

model CustomerAddress {
  id                   String    @id @default(uuid()) @db.Uuid
  customerId           String    @db.Uuid
  label                String?
  recipientName        String?
  phone                String?
  addressLine          String
  addressLine2         String?
  area                 String?
  city                 String
  postalCode           String?
  landmark             String?
  deliveryInstructions String?
  isDefault            Boolean   @default(false)
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer         CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourcingRequests SourcingRequest[]
  orders           Order[]

  @@index([customerId, isDefault])
  @@index([customerId, isActive])
  @@map("customer_addresses")
}

model Vehicle {
  id                 String    @id @default(uuid()) @db.Uuid
  customerId         String    @db.Uuid
  make               String
  model              String
  year               Int?
  variant            String?
  registrationNumber String?
  chassisVin         String?
  engineInfo         String?
  notes              String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer         CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourcingRequests SourcingRequest[]
  requestItems     SourcingRequestItem[]

  @@index([customerId, isActive])
  @@index([make, model, year])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Product catalogue
// ---------------------------------------------------------------------------

model PartCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  imagePath   String?
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent                   PartCategory?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                 PartCategory[]            @relation("CategoryTree")
  products                 Product[]
  requestItems             SourcingRequestItem[]
  categoryRequests         SupplierCategoryRequest[] @relation("CategoryRequestApprovedCategory")
  proposedCategoryRequests SupplierCategoryRequest[] @relation("CategoryRequestProposedParent")

  @@index([parentId])
  @@index([isActive])
  @@map("part_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  /// Catalogue SKU / public product code; generated or curated by services later.
  catalogueCode String?   @unique
  name          String
  description   String?
  imagePath     String?
  categoryId    String    @db.Uuid
  brandId       String?   @db.Uuid
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category       PartCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  numbers        ProductNumber[]
  compatibility  ProductCompatibility[]
  inventory      SupplierInventory[]
  requestItems   SourcingRequestItem[]
  quotationItems QuotationItem[]
  orderItems     OrderItem[]

  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([name])
  @@map("products")
}

model ProductNumber {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  partNumber   String
  isPrimary    Boolean  @default(false)
  manufacturer String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, partNumber])
  @@index([partNumber])
  @@map("product_numbers")
}

model ProductCompatibility {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  make      String
  model     String
  yearFrom  Int?
  yearTo    Int?
  variant   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([make, model])
  @@map("product_compatibilities")
}

model SupplierInventory {
  id                    String                         @id @default(uuid()) @db.Uuid
  businessId            String                         @db.Uuid
  productId             String                         @db.Uuid
  sku                   String
  stockQuantity         Int                            @default(0)
  reservedQuantity      Int                            @default(0)
  unitPrice             Decimal                        @db.Decimal(12, 2)
  minimumStock          Int                            @default(0)
  availabilityStatus    InventoryAvailability          @default(OUT_OF_STOCK)
  condition             ProductCondition               @default(NEW)
  listingClassification SupplierListingClassification?
  publicationStatus     ListingPublicationStatus       @default(DRAFT)
  moderationStatus      ListingModerationStatus        @default(NOT_REVIEWED)
  moderatedByUserId     String?                        @db.Uuid
  moderatedAt           DateTime?
  publishedAt           DateTime?
  preparationTimeMin    Int?
  notes                 String?
  lastStockUpdateAt     DateTime?
  isAvailable           Boolean                        @default(true)
  isActive              Boolean                        @default(true)
  legacyImageExempt     Boolean                        @default(false)
  version               Int                            @default(0)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  business         SupplierBusiness           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product          Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockAdjustments InventoryStockAdjustment[]
  quotationItems   QuotationItem[]
  reservations     InventoryReservation[]
  orderItems       OrderItem[]
  purchaseRequests SourcingRequest[]
  images           SupplierListingImage[]
  moderatedBy      User?                      @relation("ListingModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, sku])
  @@unique([businessId, productId, listingClassification])
  @@index([businessId, availabilityStatus])
  @@index([productId, availabilityStatus])
  @@index([businessId, isActive])
  @@index([legacyImageExempt, publicationStatus, moderationStatus])
  @@map("supplier_inventory")
}

model SupplierListingImage {
  id           String   @id @default(uuid()) @db.Uuid
  inventoryId  String   @db.Uuid
  storageKey   String   @unique
  mimeType     String
  byteSize     Int
  width        Int
  height       Int
  displayOrder Int
  isPrimary    Boolean  @default(false)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventory SupplierInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, displayOrder])
  @@index([inventoryId, isPrimary])
  @@map("supplier_listing_images")
}

model InventoryStockAdjustment {
