  acceptance OptionAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, attemptedAt])
  @@map("order_conversion_attempts")
}

model InventoryReservation {
  id          String                     @id @default(uuid()) @db.Uuid
  orderItemId String                     @unique @db.Uuid
  businessId  String                     @db.Uuid
  inventoryId String                     @db.Uuid
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  reservedAt  DateTime                   @default(now())
  releasedAt  DateTime?
  consumedAt  DateTime?
  restoredAt  DateTime?
