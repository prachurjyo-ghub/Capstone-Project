  updatedAt   DateTime                   @updatedAt

  orderItem OrderItem                   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  business  SupplierBusiness            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  inventory SupplierInventory           @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  history   InventoryReservationEvent[]

  @@index([inventoryId, status])
  @@index([businessId, status])
