  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  request   SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUser User?           @relation("RequestStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("request_status_history")
}

model SupplierRequestAssignment {
  id          String                   @id @default(uuid()) @db.Uuid
  requestId   String                   @db.Uuid
  businessId  String                   @db.Uuid
  status      SupplierAssignmentStatus @default(ASSIGNED)
