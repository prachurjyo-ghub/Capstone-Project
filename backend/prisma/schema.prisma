  reservation InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actorUser   User?                @relation("InventoryReservationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@map("inventory_reservation_events")
}

model OrderCancellationRequest {
