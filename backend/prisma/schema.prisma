  decidedBy        User?             @relation("OrderReturnDecisionActor", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  receivedBy       User?             @relation("OrderReturnReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull)
