}

// ---------------------------------------------------------------------------
// Orders and fulfillment
// ---------------------------------------------------------------------------

model Order {
  id                              String                  @id @default(uuid()) @db.Uuid
  /// Human-readable order number (e.g. ORD-1045). Generated by application services later.
  orderNumber                     String                  @unique
  acceptanceId                    String?                 @unique @db.Uuid
  customerId                      String                  @db.Uuid
  businessId                      String                  @db.Uuid
  requestId                       String?                 @db.Uuid
  quotationId                     String?                 @db.Uuid
  deliveryAddressId               String?                 @db.Uuid
  status                          OrderStatus             @default(CONFIRMED)
  version                         Int                     @default(0)
  currency                        String                  @default("BDT")
  supplierSubtotal                Decimal                 @db.Decimal(12, 2)
  platformMargin                  Decimal                 @default(0) @db.Decimal(12, 2)
  deliveryCharge                  Decimal                 @default(0) @db.Decimal(12, 2)
  priorityCharge                  Decimal                 @default(0) @db.Decimal(12, 2)
  customerTotal                   Decimal                 @db.Decimal(12, 2)
  supplierPayable                 Decimal                 @db.Decimal(12, 2)
  deliverySnapshot                Json?
  externalSourcingRequired        Boolean                 @default(false)
  supplierAvailabilityConfirmedAt DateTime?
  supplierAvailabilityConfirmedBy String?                 @db.Uuid
  urgentEligibility               UrgentEligibilityStatus @default(NOT_APPLICABLE)
  urgentEligibilityBasis          String?
  estimatedWindowStart            DateTime?
  estimatedWindowEnd              DateTime?
  targetDeadlineAt                DateTime?
  confirmedAt                     DateTime?
  completedAt                     DateTime?
  cancelledAt                     DateTime?
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt

  customer              CustomerProfile            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  acceptance            OptionAcceptance?          @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)
  business              SupplierBusiness           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  request               SourcingRequest?           @relation(fields: [requestId], references: [id], onDelete: SetNull)
  quotation             Quotation?                 @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  deliveryAddress       CustomerAddress?           @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  fulfillmentHistory    FulfillmentStatusHistory[]
  delivery              Delivery?
  invoices              Invoice[]
  transactions          Transaction[]
  settlements           SupplierSettlement[]
  refunds               Refund[]
  payable               SupplierPayable?
  operationalCases      OperationalCase[]
  conversations         Conversation[]
  conversionAttempt     OrderConversionAttempt?
  cancellations         OrderCancellationRequest[]
  failures              OrderFailure[]
  return                OrderReturn?
  urgentHistory         UrgentFulfillmentHistory[]
  commissionReservation CommissionReservation?
  walletEntries         WalletLedgerEntry[]

  @@index([customerId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([status, createdAt])
  @@index([quotationId])
  @@map("orders")
}

model OrderItem {
  id                  String            @id @default(uuid()) @db.Uuid
  orderId             String            @db.Uuid
  acceptanceItemId    String?           @unique @db.Uuid
  requestItemId       String?           @db.Uuid
  quotationItemId     String?           @db.Uuid
  productId           String?           @db.Uuid
  inventoryId         String?           @db.Uuid
  lineNumber          Int
  description         String
  brand               String?
  partNumber          String?
  condition           ProductCondition?
  compatibilityNotes  String?
  alternativePartInfo String?
  isAlternative       Boolean           @default(false)
  quantity            Int               @default(1)
  supplierUnitPrice   Decimal           @db.Decimal(12, 2)
  customerUnitPrice   Decimal           @db.Decimal(12, 2)
  supplierLineTotal   Decimal           @db.Decimal(12, 2)
  customerLineTotal   Decimal           @db.Decimal(12, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  acceptanceItem OptionAcceptanceItem? @relation(fields: [acceptanceItemId], references: [id], onDelete: Restrict)
  requestItem    SourcingRequestItem?  @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  quotationItem  QuotationItem?        @relation(fields: [quotationItemId], references: [id], onDelete: SetNull)
  product        Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  inventory      SupplierInventory?    @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
