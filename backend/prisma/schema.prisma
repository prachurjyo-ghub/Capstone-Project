// ---------------------------------------------------------------------------
// Quotations
// ---------------------------------------------------------------------------

model Quotation {
  id                   String            @id @default(uuid()) @db.Uuid
  /// Human-readable quotation number (e.g. QT-8821). Generated by application services later.
  quotationNumber      String            @unique
  requestId            String            @db.Uuid
  businessId           String            @db.Uuid
  assignmentId         String?           @db.Uuid
  submissionKey        String?
  version              Int               @default(0)
  status               QuotationStatus   @default(DRAFT)
  adminReviewStatus    AdminReviewStatus @default(PENDING)
  revisionGroupId      String            @db.Uuid
  revisionNumber       Int               @default(1)
  supersedesId         String?           @db.Uuid
  brandOffered         String?
  condition            ProductCondition  @default(NEW)
  availableQuantity    Int?
  /// Supplier unit/base pricing before platform adjustments.
  supplierSubtotal     Decimal           @db.Decimal(12, 2)
  preparationTimeMin   Int?
  deliveryEstimateText String?
  compatibilityNotes   String?
  alternativePartInfo  String?
  supplierNotes        String?
  adminNotes           String?
  adminMargin          Decimal           @default(0) @db.Decimal(12, 2)
  deliveryCharge       Decimal           @default(0) @db.Decimal(12, 2)
  priorityCharge       Decimal           @default(0) @db.Decimal(12, 2)
  /// Customer-facing total presented after admin review.
  customerTotal        Decimal           @db.Decimal(12, 2)
  validUntil           DateTime?
  submittedAt          DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  request         SourcingRequest            @relation(fields: [requestId], references: [id], onDelete: Restrict)
  business        SupplierBusiness           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  assignment      SupplierRequestAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  supersedes      Quotation?                 @relation("QuotationRevisions", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions       Quotation[]                @relation("QuotationRevisions")
  items           QuotationItem[]
  statusHistory   QuotationStatusHistory[]
  orders          Order[]
  conversations   Conversation[]
  clarifications  SupplierClarification[]
  sourcingOptions SourcingOption[]

  @@unique([revisionGroupId, revisionNumber])
  @@unique([businessId, submissionKey])
  @@index([assignmentId, status])
  @@index([requestId, status])
  @@index([businessId, status, createdAt])
  @@index([adminReviewStatus, status])
  @@index([validUntil])
  @@map("quotations")
}

model QuotationItem {
  id                  String           @id @default(uuid()) @db.Uuid
  quotationId         String           @db.Uuid
  requestItemId       String?          @db.Uuid
  productId           String?          @db.Uuid
  inventoryId         String?          @db.Uuid
  alternativeToItemId String?          @db.Uuid
  lineNumber          Int
  description         String
  brand               String?
  partNumber          String?
  condition           ProductCondition @default(NEW)
  quantity            Int              @default(1)
  supplierUnitPrice   Decimal          @db.Decimal(12, 2)
  supplierLineTotal   Decimal          @db.Decimal(12, 2)
  customerUnitPrice   Decimal?         @db.Decimal(12, 2)
  customerLineTotal   Decimal?         @db.Decimal(12, 2)
  compatibilityNotes  String?
  alternativePartInfo String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  quotation       Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestItem     SourcingRequestItem?   @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  product         Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  inventory       SupplierInventory?     @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  alternativeTo   QuotationItem?         @relation("QuotationItemAlternatives", fields: [alternativeToItemId], references: [id], onDelete: Cascade)
  alternatives    QuotationItem[]        @relation("QuotationItemAlternatives")
  optionLines     SourcingOptionLine[]
  acceptanceItems OptionAcceptanceItem[]
  orderItems      OrderItem[]

  @@unique([quotationId, lineNumber])
  @@index([quotationId])
  @@index([requestItemId])
  @@index([inventoryId])
  @@index([alternativeToItemId])
  @@map("quotation_items")
}

model QuotationStatusHistory {
  id          String           @id @default(uuid()) @db.Uuid
  quotationId String           @db.Uuid
  fromStatus  QuotationStatus?
  toStatus    QuotationStatus
  note        String?
  actorUserId String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  actorUser User?     @relation("QuotationStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([quotationId, createdAt])
  @@map("quotation_status_history")
}

model SourcingOption {
  id                   String               @id @default(uuid()) @db.Uuid
  optionNumber         String               @unique
  requestId            String               @db.Uuid
  quotationId          String               @db.Uuid
  versionGroupId       String               @db.Uuid
  revisionNumber       Int                  @default(1)
  supersedesId         String?              @db.Uuid
  status               SourcingOptionStatus @default(DRAFT)
  currency             String               @default("BDT")
  supplierSubtotal     Decimal              @db.Decimal(12, 2)
  platformMargin       Decimal              @default(0) @db.Decimal(12, 2)
  deliveryCharge       Decimal              @default(0) @db.Decimal(12, 2)
  priorityCharge       Decimal              @default(0) @db.Decimal(12, 2)
  customerItemsTotal   Decimal              @db.Decimal(12, 2)
  customerTotal        Decimal              @db.Decimal(12, 2)
  preparationTimeMin   Int?
  deliveryEstimateText String?
  compatibilityNotes   String?
  customerNotes        String?
  internalNotes        String?
  validUntil           DateTime
  publishedAt          DateTime?
  withdrawnAt          DateTime?
  rejectedAt           DateTime?
  invalidatedAt        DateTime?
  invalidationReason   String?
  version              Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  request        SourcingRequest               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quotation      Quotation                     @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  supersedes     SourcingOption?               @relation("SourcingOptionRevisions", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions      SourcingOption[]              @relation("SourcingOptionRevisions")
  lines          SourcingOptionLine[]
  history        SourcingOptionHistory[]
  clarifications CustomerOptionClarification[]
  acceptance     OptionAcceptance?

  @@unique([versionGroupId, revisionNumber])
  @@index([requestId, status, createdAt])
  @@index([quotationId, status])
  @@index([validUntil])
  @@map("sourcing_options")
}

model SourcingOptionLine {
  id                  String           @id @default(uuid()) @db.Uuid
  optionId            String           @db.Uuid
  requestItemId       String           @db.Uuid
  quotationItemId     String           @db.Uuid
  lineNumber          Int
  description         String
  brand               String?
  partNumber          String?
  condition           ProductCondition
  quantity            Int
  supplierUnitPrice   Decimal          @db.Decimal(12, 2)
  supplierLineTotal   Decimal          @db.Decimal(12, 2)
  customerUnitPrice   Decimal          @db.Decimal(12, 2)
  customerLineTotal   Decimal          @db.Decimal(12, 2)
  compatibilityNotes  String?
  alternativePartInfo String?
  isAlternative       Boolean          @default(false)
  createdAt           DateTime         @default(now())

  option          SourcingOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  requestItem     SourcingRequestItem    @relation(fields: [requestItemId], references: [id], onDelete: Restrict)
  quotationItem   QuotationItem          @relation(fields: [quotationItemId], references: [id], onDelete: Restrict)
  acceptanceItems OptionAcceptanceItem[]

  @@unique([optionId, requestItemId])
  @@unique([optionId, lineNumber])
  @@index([quotationItemId])
  @@map("sourcing_option_lines")
}

model SourcingOptionHistory {
  id          String                @id @default(uuid()) @db.Uuid
  optionId    String                @db.Uuid
  fromStatus  SourcingOptionStatus?
  toStatus    SourcingOptionStatus
  reason      String?
  actorUserId String?               @db.Uuid
  createdAt   DateTime              @default(now())

  option    SourcingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  actorUser User?          @relation("SourcingOptionHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([optionId, createdAt])
  @@map("sourcing_option_history")
}

model CustomerOptionClarification {
  id              String    @id @default(uuid()) @db.Uuid
  optionId        String    @db.Uuid
  customerId      String    @db.Uuid
  question        String
  askedByUserId   String?   @db.Uuid
  askedAt         DateTime  @default(now())
  reply           String?
  repliedByUserId String?   @db.Uuid
  repliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  option        SourcingOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
