  reportedBy User  @relation("OrderFailureReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, reportedAt])
  @@map("order_failures")
}

model OrderReturn {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @unique @db.Uuid
  customerId        String            @db.Uuid
  status            OrderReturnStatus @default(REQUESTED)
  reason            String
  requestedByUserId String            @db.Uuid
  requestedAt       DateTime          @default(now())
  decisionReason    String?
  decidedByUserId   String?           @db.Uuid
  decidedAt         DateTime?
  receivedByUserId  String?           @db.Uuid
