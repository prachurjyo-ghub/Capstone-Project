  allocationReleaseReason String?
  createdAt               DateTime  @default(now())

  option            SourcingOption          @relation(fields: [optionId], references: [id], onDelete: Restrict)
  request           SourcingRequest         @relation(fields: [requestId], references: [id], onDelete: Restrict)
  customer          CustomerProfile         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             OptionAcceptanceItem[]
