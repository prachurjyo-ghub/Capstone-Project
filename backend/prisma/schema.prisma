  askedByUser   User?           @relation("CustomerOptionClarificationAsker", fields: [askedByUserId], references: [id], onDelete: SetNull)
  repliedByUser User?           @relation("CustomerOptionClarificationReplier", fields: [repliedByUserId], references: [id], onDelete: SetNull)

  @@index([optionId, askedAt])
  @@index([customerId, askedAt])
  @@map("customer_option_clarifications")
}

model OptionAcceptance {
  id                      String    @id @default(uuid()) @db.Uuid
  optionId                String    @unique @db.Uuid
  requestId               String    @db.Uuid
  customerId              String    @db.Uuid
  idempotencyKey          String
  optionRevision          Int
  currency                String
  customerItemsTotal      Decimal   @db.Decimal(12, 2)
  deliveryCharge          Decimal   @db.Decimal(12, 2)
  priorityCharge          Decimal   @db.Decimal(12, 2)
  customerTotal           Decimal   @db.Decimal(12, 2)
  deliverySnapshot        Json
  acceptedAt              DateTime  @default(now())
