  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  requestedBy User            @relation("OrderCancellationRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy   User?           @relation("OrderCancellationDecisionActor", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([customerId, requestedAt])
