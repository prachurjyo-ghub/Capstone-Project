// ---------------------------------------------------------------------------
// Financial records
// ---------------------------------------------------------------------------

model Transaction {
  id                   String          @id @default(uuid()) @db.Uuid
  /// Human-readable transaction reference. Generated by application services later.
  reference            String          @unique
  type                 TransactionType
  status               PaymentStatus   @default(PENDING)
  customerId           String?         @db.Uuid
  orderId              String?         @db.Uuid
  invoiceId            String?         @db.Uuid
  settlementId         String?         @db.Uuid
  refundId             String?         @db.Uuid
  businessId           String?         @db.Uuid
  recordedByUserId     String?         @db.Uuid
  reversalOfId         String?         @unique @db.Uuid
  idempotencyKey       String?         @unique
  externalReferenceKey String?         @unique
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("BDT")
  method               String?
  externalReference    String?
  description          String?
  safeNote             String?
  occurredAt           DateTime?
  processedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  customer   CustomerProfile?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice    Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  settlement SupplierSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  refund     Refund?             @relation(fields: [refundId], references: [id], onDelete: SetNull)
  business   SupplierBusiness?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  recordedBy User?               @relation("TransactionRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  reversalOf Transaction?        @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal   Transaction?        @relation("TransactionReversal")

  @@index([type, status, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([businessId, createdAt])
  @@index([invoiceId, type])
  @@index([refundId])
  @@map("transactions")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  /// Human-readable invoice number. Generated by application services later.
  invoiceNumber    String        @unique
  customerId       String        @db.Uuid
  orderId          String?       @unique @db.Uuid
  issuedByUserId   String?       @db.Uuid
  voidedByUserId   String?       @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @db.Decimal(12, 2)
  deliveryCharge   Decimal       @default(0) @db.Decimal(12, 2)
  priorityCharge   Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  currency         String        @default("BDT")
  issuedAt         DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  voidReason       String?
  sellerSnapshot   Json?
  customerSnapshot Json?
  deliverySnapshot Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  transactions Transaction[]
  issuedBy     User?           @relation("InvoiceIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  voidedBy     User?           @relation("InvoiceVoidActor", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  orderItemId String?  @db.Uuid
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model SupplierSettlement {
  id                   String           @id @default(uuid()) @db.Uuid
  reference            String?          @unique
  businessId           String           @db.Uuid
  orderId              String?          @db.Uuid
  recordedByUserId     String?          @db.Uuid
  idempotencyKey       String?          @unique
  externalReferenceKey String?          @unique
  status               SettlementStatus @default(PENDING)
  grossAmount          Decimal          @db.Decimal(12, 2)
  platformFee          Decimal          @default(0) @db.Decimal(12, 2)
  netPayable           Decimal          @db.Decimal(12, 2)
  currency             String           @default("BDT")
  scheduledFor         DateTime?
  paidAt               DateTime?
  occurredAt           DateTime?
  method               String?
  externalReference    String?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  business     SupplierBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  allocations  SettlementAllocation[]
  recordedBy   User?                  @relation("SettlementRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@index([orderId])
  @@map("supplier_settlements")
}

model SupplierPayable {
  id             String                @id @default(uuid()) @db.Uuid
  orderId        String                @unique @db.Uuid
  businessId     String                @db.Uuid
  status         SupplierPayableStatus @default(OPEN)
  originalAmount Decimal               @db.Decimal(12, 2)
  recoveryAmount Decimal               @default(0) @db.Decimal(12, 2)
  eligibleAt     DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  business    SupplierBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  allocations SettlementAllocation[]
  recoveries  SupplierRecovery[]

  @@index([businessId, status, eligibleAt])
  @@map("supplier_payables")
}

model SettlementAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  settlementId String   @db.Uuid
  payableId    String   @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  settlement SupplierSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payable    SupplierPayable    @relation(fields: [payableId], references: [id], onDelete: Restrict)

  @@unique([settlementId, payableId])
  @@index([payableId])
  @@map("settlement_allocations")
}

model SupplierRecovery {
  id            String   @id @default(uuid()) @db.Uuid
  payableId     String   @db.Uuid
  orderReturnId String   @unique @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  reason        String
  createdAt     DateTime @default(now())

  payable     SupplierPayable @relation(fields: [payableId], references: [id], onDelete: Restrict)
  orderReturn OrderReturn     @relation(fields: [orderReturnId], references: [id], onDelete: Restrict)

  @@index([payableId])
  @@map("supplier_recoveries")
}

model Refund {
  id                   String       @id @default(uuid()) @db.Uuid
  customerId           String       @db.Uuid
  orderId              String?      @db.Uuid
  status               RefundStatus @default(REQUESTED)
  amount               Decimal      @db.Decimal(12, 2)
  currency             String       @default("BDT")
  reason               String?
  idempotencyKey       String?      @unique
  approvedByUserId     String?      @db.Uuid
  approvedAt           DateTime?
  processedByUserId    String?      @db.Uuid
  method               String?
  externalReference    String?
  externalReferenceKey String?      @unique
  processedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  approvedBy   User?           @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  processedBy  User?           @relation("RefundProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([orderId])
  @@map("refunds")
}

model PlatformBusinessConfig {
  id              String   @id @default(uuid()) @db.Uuid
  configKey       String   @unique @default("default")
  legalName       String
  tradingName     String
  address         String
  phone           String?
  email           String?
  taxIdentifier   String?
  isPlaceholder   Boolean  @default(true)
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("BusinessConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("platform_business_config")
}

// ---------------------------------------------------------------------------
// Supplier prepaid credits and commission accounting
// ---------------------------------------------------------------------------

model CommissionPolicy {
  id              String    @id @default(uuid()) @db.Uuid
  rateBps         Int
  isActive        Boolean   @default(true)
  reason          String
  effectiveFrom   DateTime  @default(now())
  endedAt         DateTime?
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())

  createdBy    User                    @relation("CommissionPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reservations CommissionReservation[]

  @@index([isActive, effectiveFrom])
  @@map("commission_policies")
}

model SupplierWallet {
  id              String               @id @default(uuid()) @db.Uuid
  businessId      String               @unique @db.Uuid
  status          SupplierWalletStatus @default(ACTIVE)
  availableCredit Decimal              @default(0) @db.Decimal(14, 2)
  reservedCredit  Decimal              @default(0) @db.Decimal(14, 2)
  version         Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  business     SupplierBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  topUps       WalletTopUp[]
  entries      WalletLedgerEntry[]
  reservations CommissionReservation[]

  @@index([status, updatedAt])
  @@map("supplier_wallets")
}

model WalletTopUp {
  id                String            @id @default(uuid()) @db.Uuid
  walletId          String            @db.Uuid
  businessId        String            @db.Uuid
  amount            Decimal           @db.Decimal(14, 2)
  currency          String            @default("BDT")
  status            WalletTopUpStatus @default(PENDING)
  paymentMethod     String
  externalReference String
  evidenceReference String?
  supplierNote      String?
  decisionReason    String?
  requestedByUserId String            @db.Uuid
  reviewedByUserId  String?           @db.Uuid
  idempotencyKey    String            @unique
  requestedAt       DateTime          @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  wallet      SupplierWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  business    SupplierBusiness    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  requestedBy User                @relation("WalletTopUpCreator", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?               @relation("WalletTopUpReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  entries     WalletLedgerEntry[]

  @@unique([businessId, externalReference])
  @@index([status, requestedAt])
  @@index([businessId, requestedAt])
  @@map("wallet_top_ups")
}

model CommissionReservation {
  id                  String                      @id @default(uuid()) @db.Uuid
  walletId            String                      @db.Uuid
  businessId          String                      @db.Uuid
  orderId             String                      @unique @db.Uuid
  policyId            String                      @db.Uuid
  status              CommissionReservationStatus @default(RESERVED)
  eligibleAmount      Decimal                     @db.Decimal(14, 2)
  commissionRateBps   Int
  commissionAmount    Decimal                     @db.Decimal(14, 2)
  currency            String                      @default("BDT")
  idempotencyKey      String                      @unique
  reservedAt          DateTime                    @default(now())
  settledAt           DateTime?
  releasedAt          DateTime?
  reversedAt          DateTime?
  settlementReference String?
  releaseReason       String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  wallet   SupplierWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  business SupplierBusiness    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order    Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  policy   CommissionPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  entries  WalletLedgerEntry[]

  @@index([businessId, status, createdAt])
  @@index([status, createdAt])
  @@map("commission_reservations")
}

model WalletLedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  walletId         String          @db.Uuid
  businessId       String          @db.Uuid
  type             WalletEntryType
  availableDelta   Decimal         @default(0) @db.Decimal(14, 2)
  reservedDelta    Decimal         @default(0) @db.Decimal(14, 2)
  availableBalance Decimal         @db.Decimal(14, 2)
  reservedBalance  Decimal         @db.Decimal(14, 2)
  topUpId          String?         @db.Uuid
  reservationId    String?         @db.Uuid
  orderId          String?         @db.Uuid
  actorUserId      String?         @db.Uuid
  reversalOfId     String?         @unique @db.Uuid
  idempotencyKey   String          @unique
  reason           String
  metadata         Json?
  createdAt        DateTime        @default(now())

  wallet      SupplierWallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  business    SupplierBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  topUp       WalletTopUp?           @relation(fields: [topUpId], references: [id], onDelete: Restrict)
  reservation CommissionReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  order       Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorUser   User?                  @relation("WalletEntryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reversalOf  WalletLedgerEntry?     @relation("WalletEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal    WalletLedgerEntry?     @relation("WalletEntryReversal")

  @@index([walletId, createdAt])
  @@index([businessId, type, createdAt])
  @@index([orderId])
  @@map("wallet_ledger_entries")
}

// ---------------------------------------------------------------------------
// Supplier subscriptions and category governance
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  durationMonths Int
  price          Decimal   @db.Decimal(12, 2)
  currency       String    @default("BDT")
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscriptions SupplierSubscription[]
  invoices      SubscriptionInvoice[]

  @@index([isActive, durationMonths])
  @@map("subscription_plans")
}

model SupplierSubscription {
  id                     String                     @id @default(uuid()) @db.Uuid
  businessId             String                     @db.Uuid
  planId                 String?                    @db.Uuid
  status                 SupplierSubscriptionStatus @default(PENDING)
  planNameSnapshot       String
  durationMonthsSnapshot Int
  priceSnapshot          Decimal                    @db.Decimal(12, 2)
  currency               String                     @default("BDT")
  startsAt               DateTime
  endsAt                 DateTime
  activatedAt            DateTime?
  suspendedAt            DateTime?
  cancelledAt            DateTime?
  complimentaryReason    String?
  statusReason           String?
  createdByUserId        String                     @db.Uuid
  idempotencyKey         String                     @unique
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  business  SupplierBusiness            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan      SubscriptionPlan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdBy User                        @relation("SubscriptionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  invoice   SubscriptionInvoice?
  history   SupplierSubscriptionEvent[]

  @@index([businessId, status, startsAt, endsAt])
  @@index([endsAt, status])
  @@map("supplier_subscriptions")
}

model SupplierSubscriptionEvent {
  id             String                      @id @default(uuid()) @db.Uuid
  subscriptionId String                      @db.Uuid
  fromStatus     SupplierSubscriptionStatus?
  toStatus       SupplierSubscriptionStatus
  reason         String?
  actorUserId    String                      @db.Uuid
  createdAt      DateTime                    @default(now())

  subscription SupplierSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  actorUser    User                 @relation("SubscriptionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@map("supplier_subscription_events")
}

model SubscriptionInvoice {
  id                     String                    @id @default(uuid()) @db.Uuid
  invoiceNumber          String                    @unique
  businessId             String                    @db.Uuid
  planId                 String?                   @db.Uuid
  subscriptionId         String?                   @unique @db.Uuid
  status                 SubscriptionInvoiceStatus @default(ISSUED)
  planNameSnapshot       String
  durationMonthsSnapshot Int
  amount                 Decimal                   @db.Decimal(12, 2)
  currency               String                    @default("BDT")
  periodStartsAt         DateTime
  periodEndsAt           DateTime
  issuedAt               DateTime
  dueAt                  DateTime
  paidAt                 DateTime?
  voidedAt               DateTime?
  voidReason             String?
  sellerSnapshot         Json
  supplierSnapshot       Json
  issuedByUserId         String                    @db.Uuid
  voidedByUserId         String?                   @db.Uuid
  idempotencyKey         String                    @unique
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  business     SupplierBusiness      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription SupplierSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     SubscriptionPayment[]
  issuedBy     User                  @relation("SubscriptionInvoiceIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  voidedBy     User?                 @relation("SubscriptionInvoiceVoidActor", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status, issuedAt])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id                   String                  @id @default(uuid()) @db.Uuid
  invoiceId            String                  @db.Uuid
  kind                 SubscriptionPaymentKind @default(PAYMENT)
  amount               Decimal                 @db.Decimal(12, 2)
  currency             String                  @default("BDT")
  method               String
  externalReference    String?
  externalReferenceKey String?                 @unique
  occurredAt           DateTime
  safeNote             String?
  reversalOfId         String?                 @unique @db.Uuid
  recordedByUserId     String                  @db.Uuid
  idempotencyKey       String                  @unique
  createdAt            DateTime                @default(now())

  invoice    SubscriptionInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reversalOf SubscriptionPayment? @relation("SubscriptionPaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal   SubscriptionPayment? @relation("SubscriptionPaymentReversal")
  recordedBy User                 @relation("SubscriptionPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([invoiceId, kind, createdAt])
  @@map("subscription_payments")
}

model SupplierCategoryRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  businessId         String                @db.Uuid
  proposedName       String
  normalizedName     String
  proposedParentId   String?               @db.Uuid
  description        String?
  justification      String
  status             CategoryRequestStatus @default(PENDING)
  approvedCategoryId String?               @db.Uuid
  decisionReason     String?
  createdByUserId    String                @db.Uuid
  reviewedByUserId   String?               @db.Uuid
  reviewedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  business         SupplierBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  proposedParent   PartCategory?    @relation("CategoryRequestProposedParent", fields: [proposedParentId], references: [id], onDelete: SetNull)
  approvedCategory PartCategory?    @relation("CategoryRequestApprovedCategory", fields: [approvedCategoryId], references: [id], onDelete: SetNull)
  createdBy        User             @relation("CategoryRequestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy       User?            @relation("CategoryRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessId, status, createdAt])
  @@map("supplier_category_requests")
}

model OperationalCase {
  id               String                @id @default(uuid()) @db.Uuid
  caseNumber       String                @unique
  type             OperationalCaseType
  status           OperationalCaseStatus @default(OPEN)
  orderId          String?               @db.Uuid
  businessId       String?               @db.Uuid
  assignedToUserId String?               @db.Uuid
  title            String
  resolution       String?
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  order      Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  business   SupplierBusiness?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  assignedTo User?                    @relation("OperationalCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  history    OperationalCaseHistory[]

  @@index([status, type, createdAt])
  @@index([assignedToUserId, status])
  @@map("operational_cases")
}

model OperationalCaseHistory {
  id          String                 @id @default(uuid()) @db.Uuid
  caseId      String                 @db.Uuid
  fromStatus  OperationalCaseStatus?
  toStatus    OperationalCaseStatus
  note        String
  actorUserId String                 @db.Uuid
  createdAt   DateTime               @default(now())

  case      OperationalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actorUser User            @relation("OperationalCaseHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("operational_case_history")
}

// ---------------------------------------------------------------------------
// Communication and operations
// ---------------------------------------------------------------------------

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  scopeKey      String           @unique
  type          ConversationType @default(GENERAL)
  subject       String?
  requestId     String?          @db.Uuid
  quotationId   String?          @db.Uuid
  orderId       String?          @db.Uuid
  customerId    String?          @db.Uuid
  businessId    String?          @db.Uuid
  isClosed      Boolean          @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  request      SourcingRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)
  quotation    Quotation?                @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer     CustomerProfile?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  business     SupplierBusiness?         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([requestId])
  @@index([quotationId])
  @@index([orderId])
  @@index([customerId, lastMessageAt])
  @@index([businessId, lastMessageAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id                String          @id @default(uuid()) @db.Uuid
  conversationId    String          @db.Uuid
  userId            String          @db.Uuid
  participantType   ParticipantType
  lastReadAt        DateTime?
  lastReadMessageId String?         @db.Uuid
  joinedAt          DateTime        @default(now())
  leftAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  senderUserId   String?           @db.Uuid
  senderType     MessageSenderType
  idempotencyKey String?
  sourceType     String?
  sourceId       String?           @db.Uuid
  body           String
  sentAt         DateTime          @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?               @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]

  @@unique([conversationId, senderUserId, idempotencyKey])
  @@unique([conversationId, sourceType, sourceId])
  @@index([conversationId, sentAt])
  @@index([senderUserId])
  @@map("messages")
}

model MessageAttachment {
  id            String         @id @default(uuid()) @db.Uuid
  messageId     String         @db.Uuid
  kind          AttachmentKind @default(DOCUMENT)
  fileName      String
  mimeType      String
  storageKey    String
  byteSize      Int?
  width         Int?
  height        Int?
  contentSha256 String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  channel    NotificationChannel @default(IN_APP)
  title      String
  body       String
  entityType String?
  entityId   String?             @db.Uuid
  eventKey   String
  isRead     Boolean             @default(false)
  readAt     DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, channel, eventKey])
  @@index([userId, isRead, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @db.Uuid
  userId         String                     @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  deliveredAt    DateTime?
  lastErrorCode  String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String       @db.Uuid
  eventKey      String       @unique
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8)
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  processedAt   DateTime?
  lastErrorCode String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  /// Safe metadata only — never store secrets, hashes, or raw auth tokens.
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum GarageRole {
  OWNER
  MECHANIC
}

model Garage {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  contactPhone String
  endsAt       DateTime
  terminatedAt DateTime?
  amount       Int?
  area         String   @default("")
  type         String   @default("")
  address      String   @default("")
  phone        String   @default("")
  hours        String   @default("")
  description  String   @default("")
  services     String[] @default([])
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  members      GarageMembership[]
  jobs         GarageJob[]
  ledger       GarageLedgerEntry[]

  @@index([published, area, type])
  @@map("garages")
}

model GarageMembership {
  id        String     @id @default(uuid()) @db.Uuid
  garageId  String     @db.Uuid
  userId    String     @unique @db.Uuid
  username  String     @unique
  role      GarageRole
  active    Boolean    @default(true)
  phone     String     @default("")
  specialty String     @default("")
  photo     String?
  garage    Garage     @relation(fields: [garageId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  assigned  GarageJob[]
  ownerRecovery GarageOwnerRecovery?

  @@index([garageId, role, active])
  @@map("garage_memberships")
}

model GarageOwnerRecovery {
  memberId    String           @id @db.Uuid
  requestedAt DateTime         @default(now())
  member      GarageMembership @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([requestedAt])
  @@map("garage_owner_recovery_requests")
}

enum GarageJobStatus {
  UNASSIGNED
  ASSIGNED
  DRAFT
  SUBMITTED
  SHARED
  CLOSED
}

model GarageJob {
  id                String          @id @default(uuid()) @db.Uuid
  garageId          String          @db.Uuid
  customerId        String          @db.Uuid
  mechanicId        String?         @db.Uuid
  vehicle           String
  registration      String          @default("")
  service           String
  concern           String          @default("")
  consentAt         DateTime?
  status            GarageJobStatus @default(UNASSIGNED)
  version           Int             @default(0)
  report            Json?
  quotation         Json?
  evidenceRequested Boolean         @default(false)
  createdAt         DateTime        @default(now())
  garage            Garage          @relation(fields: [garageId], references: [id], onDelete: Restrict)
  customer          CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  mechanic          GarageMembership? @relation(fields: [mechanicId], references: [id], onDelete: Restrict)
  evidence          GarageEvidence[]
  share             GarageShare?

  @@index([garageId, createdAt])
  @@index([mechanicId, status])
  @@index([customerId])
  @@map("garage_jobs")
}

model GarageEvidence {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @db.Uuid
  name      String
  mimeType  String
  size      Int
  createdAt DateTime  @default(now())
  job       GarageJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId])
  @@map("garage_evidence")
}

model GarageShare {
  jobId       String    @id @db.Uuid
  report      Json
  quotation   Json?
  evidenceIds String[]  @db.Uuid
  sharedAt    DateTime  @default(now())
  revokedAt   DateTime?
  job         GarageJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@map("garage_shares")
}

model GarageLedgerEntry {
  id          String  @id @default(uuid()) @db.Uuid
  garageId    String  @db.Uuid
  kind        String
  amount      Int
  description String
  date        String
  garage      Garage  @relation(fields: [garageId], references: [id], onDelete: Restrict)

  @@index([garageId, date])
  @@map("garage_ledger_entries")
}
