  assignment SupplierRequestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actorUser  User?                     @relation("SupplierAssignmentHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([assignmentId, createdAt])
