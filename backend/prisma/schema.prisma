}

model InventoryReservationEvent {
  id            String                        @id @default(uuid()) @db.Uuid
  reservationId String                        @db.Uuid
  eventType     InventoryReservationEventType
  quantity      Int
  reason        String?
  actorUserId   String?                       @db.Uuid
