// ---------------------------------------------------------------------------
// Sourcing requests
// ---------------------------------------------------------------------------

model SourcingRequest {
  id                   String                  @id @default(uuid()) @db.Uuid
  /// Human-readable request number (e.g. RFQ-24018). Generated by application services later.
  requestNumber        String                  @unique
  customerId           String                  @db.Uuid
  vehicleId            String?                 @db.Uuid
  deliveryAddressId    String?                 @db.Uuid
  status               SourcingRequestStatus   @default(DRAFT)
  urgency              RequestUrgency          @default(STANDARD)
  requestType          SourcingRequestType     @default(CUSTOM_SOURCING)
  listingId            String?                 @db.Uuid
  targetBusinessId     String?                 @db.Uuid
  creditStatus         CreditRequirementStatus @default(NOT_APPLICABLE)
  title                String?
  customerNotes        String?
  adminNotes           String?
  deliveryLocationText String?
  vehicleSnapshot      Json?
  deliverySnapshot     Json?
  neededByAt           DateTime?
  submissionKey        String?
  cancelReason         String?
  version              Int                     @default(0)
  serviceAreaEligible  Boolean?
  responseDeadlineAt   DateTime?
  submittedAt          DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?
  closedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  customer          CustomerProfile             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle           Vehicle?                    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  deliveryAddress   CustomerAddress?            @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items             SourcingRequestItem[]
  attachments       RequestAttachment[]
  statusHistory     RequestStatusHistory[]
  assignments       SupplierRequestAssignment[]
  quotations        Quotation[]
  orders            Order[]
  conversations     Conversation[]
  sourcingOptions   SourcingOption[]
  optionAcceptances OptionAcceptance[]
  listing           SupplierInventory?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  targetBusiness    SupplierBusiness?           @relation("TargetSupplierRequests", fields: [targetBusinessId], references: [id], onDelete: SetNull)

  @@unique([customerId, submissionKey])
  @@index([customerId, createdAt])
  @@index([status, urgency, createdAt])
  @@index([requestType, status, createdAt])
  @@index([targetBusinessId, creditStatus, createdAt])
  @@index([listingId])
  @@index([responseDeadlineAt])
  @@index([urgency, status])
  @@map("sourcing_requests")
}

model SourcingRequestItem {
  id            String            @id @default(uuid()) @db.Uuid
  requestId     String            @db.Uuid
  lineNumber    Int
  productId     String?           @db.Uuid
  categoryId    String?           @db.Uuid
  vehicleId     String?           @db.Uuid
  description   String
  partNumber    String?
  quantity      Int               @default(1)
  status        RequestItemStatus @default(OPEN)
  customerNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  request         SourcingRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product         Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  category        PartCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vehicle         Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  attachments     RequestAttachment[]
  quotationItems  QuotationItem[]
  orderItems      OrderItem[]
  optionLines     SourcingOptionLine[]
  acceptanceItems OptionAcceptanceItem[]

  @@unique([requestId, lineNumber])
  @@index([requestId, status])
  @@index([productId])
  @@index([categoryId])
  @@map("sourcing_request_items")
}

model RequestAttachment {
  id            String         @id @default(uuid()) @db.Uuid
  requestId     String         @db.Uuid
  requestItemId String?        @db.Uuid
  kind          AttachmentKind @default(PHOTO)
  fileName      String
  mimeType      String
  storageKey    String         @unique
  byteSize      Int?
  width         Int?
  height        Int?
  contentSha256 String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  request     SourcingRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestItem SourcingRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([requestItemId])
  @@map("request_attachments")
}

model RequestStatusHistory {
  id          String                 @id @default(uuid()) @db.Uuid
  requestId   String                 @db.Uuid
