{
  "name": "partsarc-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PartsArc modular Express API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "openapi:check": "node scripts/check-openapi.mjs",
    "storage:verify:listing-images": "tsx scripts/verify-listing-image-storage.ts",
    "routes:inventory:write": "node scripts/route-inventory.mjs --write",
    "routes:inventory:check": "node scripts/route-inventory.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f ../compose.yaml up -d",
    "db:down": "docker compose -f ../compose.yaml down",
    "db:logs": "docker compose -f ../compose.yaml logs -f postgres redis",
    "db:migrate": "node --env-file=.env scripts/prisma-direct.mjs deploy",
    "db:status": "node --env-file=.env scripts/prisma-direct.mjs status",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/client-sesv2": "^3.1153.0",
    "@prisma/client": "^6.16.2",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.17",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.1.8"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^5.5.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "supertest": "^7.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.1.12"
  }
}
